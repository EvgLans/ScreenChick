<Window x:Class="ScreenChick.UI.StripWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:ScreenChick.Localization"
        Title="ScreenChick"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        SizeToContent="WidthAndHeight" WindowStartupLocation="Manual"
        FontFamily="Segoe UI" FontSize="12">

    <Window.Resources>
        <Style x:Key="PlainButton" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#F2F2F2" />
            <Setter Property="Background" Value="#3A3B3F" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Width="190" Background="#F2202124" CornerRadius="10" Padding="8" Margin="4">
        <StackPanel>
            <DockPanel Margin="2,0,2,6" Background="Transparent" Cursor="SizeAll"
                       MouseLeftButtonDown="OnHeaderDrag" ToolTip="{x:Static l:L.StripDrag}">
                <TextBlock DockPanel.Dock="Right" x:Name="CountText" Foreground="#AAAAAA" />
                <Image DockPanel.Dock="Left" Source="/ScreenChick;component/Assets/logo.png" Width="18" Height="18" Margin="0,0,5,0"
                       RenderOptions.BitmapScalingMode="Fant" />
                <TextBlock Text="ScreenChick" Foreground="#F2F2F2" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>

            <ScrollViewer x:Name="RowsScroll" VerticalScrollBarVisibility="Auto" Focusable="False">
                <ItemsControl x:Name="Rows" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,4">
                                <Button Style="{StaticResource PlainButton}" Background="#2C2D31" Padding="4"
                                        HorizontalContentAlignment="Stretch" Click="OnRowClick"
                                        Tag="{Binding Index}" ToolTip="{x:Static l:L.StripOpen}">
                                    <DockPanel LastChildFill="True" Width="160">
                                        <Grid Width="52" Height="34" Margin="0,0,6,0" DockPanel.Dock="Left">
                                            <Image Source="{Binding Thumbnail}" Stretch="Uniform"
                                                   RenderOptions.BitmapScalingMode="Fant" />
                                        </Grid>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Letter}" FontWeight="Bold" Foreground="#FFC400" />
                                            <TextBlock Text="{Binding Caption}" Foreground="#CCCCCC" FontSize="11"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DockPanel>
                                </Button>
                                <Button Style="{StaticResource PlainButton}" Content="×" Background="Transparent"
                                        Foreground="#AAAAAA" Padding="5,0,5,2" HorizontalAlignment="Right"
                                        VerticalAlignment="Top" Click="OnRowRemove" Tag="{Binding Index}"
                                        ToolTip="{x:Static l:L.StripRemove}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Button Style="{StaticResource PlainButton}" Content="{x:Static l:L.StripNewShot}" Margin="0,2,0,4" Click="OnNewShot" />
            <Button x:Name="PasteButton" Style="{StaticResource PlainButton}" Background="#FFC400" Foreground="#202124"
                    FontWeight="SemiBold" Content="{x:Static l:L.StripPasteArmed}" Click="OnPaste" />
            <TextBlock x:Name="StatusText" Foreground="#AAAAAA" FontSize="11" Margin="2,6,2,0" TextWrapping="Wrap" />
            <Button Style="{StaticResource PlainButton}" Content="{x:Static l:L.StripClear}" Background="Transparent"
                    Foreground="#888888" Padding="2" Margin="0,4,0,0" Click="OnClear" />
        </StackPanel>
    </Border>
</Window>
