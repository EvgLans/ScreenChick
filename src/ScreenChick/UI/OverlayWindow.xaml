<Window x:Class="ScreenChick.UI.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:ScreenChick.UI"
        Title="ScreenChick"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual" Background="#111111"
        FontFamily="Segoe UI" FontSize="13"
        PreviewKeyDown="OnPreviewKeyDown">

    <Window.Resources>
        <Style x:Key="ToolButton" TargetType="ButtonBase">
            <Setter Property="Foreground" Value="#F2F2F2" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ButtonBase">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#3A3B3F" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                            <Trigger Property="ToggleButton.IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FFC400" />
                                <Setter Property="Foreground" Value="#202124" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root" ClipToBounds="True">
        <Viewbox Stretch="Uniform">
            <ui:ShotSurface x:Name="Surface" Cursor="Cross"
                            MouseLeftButtonDown="OnSurfaceDown"
                            MouseMove="OnSurfaceMove"
                            MouseLeftButtonUp="OnSurfaceUp"
                            MouseLeave="OnSurfaceLeave"
                            MouseWheel="OnSurfaceWheel" />
        </Viewbox>

        <!-- Shows the screen is frozen, not live -->
        <Border BorderBrush="#FFC400" BorderThickness="2" IsHitTestVisible="False" />

        <Canvas x:Name="EditorLayer">
            <Border x:Name="Editor" Visibility="Collapsed" Width="320" Background="#FFFFFF"
                    CornerRadius="8" Padding="8" BorderBrush="#F4511E" BorderThickness="1.5" Cursor="Arrow">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.35" />
                </Border.Effect>
                <StackPanel>
                    <DockPanel Margin="0,0,0,4">
                        <TextBlock x:Name="EditorLabel" DockPanel.Dock="Left" FontWeight="Bold"
                                   Foreground="#D84315" VerticalAlignment="Center" />
                        <Button DockPanel.Dock="Right" Content="Удалить метку" Click="OnDeleteMark"
                                Focusable="False" Background="Transparent" BorderThickness="0"
                                Foreground="#777777" FontSize="12" Cursor="Hand" HorizontalAlignment="Right" />
                    </DockPanel>
                    <TextBox x:Name="CommentBox" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="140"
                             VerticalScrollBarVisibility="Auto" BorderThickness="0" FontSize="14"
                             PreviewKeyDown="OnCommentKeyDown" />
                    <TextBlock Text="Enter: сохранить · Shift+Enter: новая строка · Esc: отмена"
                               Foreground="#999999" FontSize="11" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </Canvas>

        <Border x:Name="Toolbar" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,14,0,0"
                Background="#E6202124" CornerRadius="10" Padding="6" Cursor="Arrow">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="MarkTool" GroupName="Tool" IsChecked="True" Style="{StaticResource ToolButton}"
                             Content="Метка · 1" ToolTip="Обвести или ткнуть и написать" Checked="OnToolChanged" />
                <RadioButton x:Name="RedactTool" GroupName="Tool" Style="{StaticResource ToolButton}"
                             Content="Замазать · 2" ToolTip="Провести по тому, что нужно скрыть. Колесо мыши меняет толщину" Checked="OnToolChanged" />
                <RadioButton x:Name="CropTool" GroupName="Tool" Style="{StaticResource ToolButton}"
                             Content="Обрезать · 3" ToolTip="Выделить часть снимка, которую оставить" Checked="OnToolChanged" />
                <Rectangle Width="1" Fill="#55FFFFFF" Margin="6,4" />
                <Button x:Name="UndoButton" Style="{StaticResource ToolButton}" Content="↶" ToolTip="Отменить (Ctrl+Z)" Click="OnUndo" />
                <Button x:Name="RedoButton" Style="{StaticResource ToolButton}" Content="↷" ToolTip="Вернуть (Ctrl+Y)" Click="OnRedo" />
                <Rectangle Width="1" Fill="#55FFFFFF" Margin="6,4" />
                <Button Style="{StaticResource ToolButton}" Content="Готово · Enter" FontWeight="SemiBold" Click="OnDone" />
                <Button Style="{StaticResource ToolButton}" Content="Отмена · Esc" Click="OnCancel" />
            </StackPanel>
        </Border>

        <Border x:Name="Toast" Visibility="Collapsed" VerticalAlignment="Top" HorizontalAlignment="Center"
                Margin="0,70,0,0" Background="#E6202124" CornerRadius="8" Padding="12,8" IsHitTestVisible="False">
            <TextBlock x:Name="ToastText" Foreground="White" />
        </Border>
    </Grid>
</Window>
