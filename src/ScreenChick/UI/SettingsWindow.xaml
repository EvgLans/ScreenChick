<Window x:Class="ScreenChick.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:ScreenChick.Localization"
        Title="{x:Static l:L.SettingsTitle}" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="13">
    <StackPanel Margin="16" Width="380">
        <TextBlock Text="{x:Static l:L.LanguageLabel}" FontWeight="SemiBold" />
        <ComboBox x:Name="LanguageBox" Margin="0,6,0,14">
            <ComboBoxItem Content="{x:Static l:L.LanguageAuto}" />
            <ComboBoxItem Content="Русский" />
            <ComboBoxItem Content="English" />
        </ComboBox>

        <TextBlock Text="{x:Static l:L.HotkeyLabel}" FontWeight="SemiBold" />
        <DockPanel Margin="0,6,0,14">
            <Button x:Name="RecordButton" DockPanel.Dock="Right" Content="{x:Static l:L.HotkeyChange}" Padding="12,4" Click="OnRecord" />
            <TextBlock x:Name="HotkeyText" VerticalAlignment="Center" />
        </DockPanel>

        <TextBlock Text="{x:Static l:L.DelayLabel}" FontWeight="SemiBold" />
        <DockPanel Margin="0,6,0,2">
            <TextBlock DockPanel.Dock="Right" x:Name="DelayText" Width="60" TextAlignment="Right" />
            <Slider x:Name="DelaySlider" TickFrequency="50" IsSnapToTickEnabled="True" ValueChanged="OnDelayChanged" />
        </DockPanel>
        <TextBlock Text="{x:Static l:L.DelayHint}" Foreground="#777777"
                   FontSize="12" Margin="0,0,0,14" />

        <CheckBox x:Name="AutostartBox" Content="{x:Static l:L.AutostartLabel}" Margin="0,0,0,16" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{x:Static l:L.Save}" IsDefault="True" Padding="16,4" Margin="0,0,8,0" Click="OnSave" />
            <Button Content="{x:Static l:L.Cancel}" IsCancel="True" Padding="16,4" />
        </StackPanel>
    </StackPanel>
</Window>
