<Window x:Class="ScreenChick.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScreenChick: настройки" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="13">
    <StackPanel Margin="16" Width="380">
        <TextBlock Text="Клавиша снимка" FontWeight="SemiBold" />
        <DockPanel Margin="0,6,0,14">
            <Button x:Name="RecordButton" DockPanel.Dock="Right" Content="Изменить" Padding="12,4" Click="OnRecord" />
            <TextBlock x:Name="HotkeyText" VerticalAlignment="Center" />
        </DockPanel>

        <TextBlock Text="Пауза между картинками при вставке" FontWeight="SemiBold" />
        <DockPanel Margin="0,6,0,2">
            <TextBlock DockPanel.Dock="Right" x:Name="DelayText" Width="60" TextAlignment="Right" />
            <Slider x:Name="DelaySlider" TickFrequency="50" IsSnapToTickEnabled="True" ValueChanged="OnDelayChanged" />
        </DockPanel>
        <TextBlock Text="Увеличь, если чат успевает принять не все снимки." Foreground="#777777"
                   FontSize="12" Margin="0,0,0,14" />

        <CheckBox x:Name="AutostartBox" Content="Запускать вместе с Windows" Margin="0,0,0,16" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Сохранить" IsDefault="True" Padding="16,4" Margin="0,0,8,0" Click="OnSave" />
            <Button Content="Отмена" IsCancel="True" Padding="16,4" />
        </StackPanel>
    </StackPanel>
</Window>
